{
  "name": "hybrid-gate-frontend",
  "version": "6.0.2",
  "private": true,
  "description": "Frontend monorepo for hybrid-gate (next-forge based). App: apps/panel.",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && bunx prisma format && bunx prisma generate && bunx prisma migrate dev",
    "migrate:deploy": "cd packages/database && bunx prisma generate && bunx prisma migrate deploy",
    "db:push": "cd packages/database && bunx prisma format && bunx prisma generate && bunx prisma db push",
    "clean": "git clean -xdf node_modules",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck --filter=panel --filter=backend",
    "backend:setup": "pnpm --filter backend setup",
    "smoke": "pnpm --filter panel smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.14",
    "@types/node": "^25.3.5",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "ultracite": "7.2.5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "parse5": "^7.2.1"
  }
}
